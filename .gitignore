# Dependencies and build
/node_modules
/dist

# Environment and secrets — never commit
# Broad glob on purpose: .env.production and friends hold raw executor private
# keys, so anything env-shaped stays out of git except the checked-in template.
.env*
!.env.example
deploy.final.yml
prev.yml
*.final.yml

# IDE and OS
/.vscode
.DS_Store
*.log
npm-debug.log*
