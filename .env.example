# Redis is provided by the compose sidecar — do not change this
REDIS_URL=redis://redis:6379

# Alchemy RPC key for Base network
ALCHEMY_API_KEY=

# Diamond contract address on Base
DIAMOND_ADDRESS=

# Discord channel webhooks — one per alert type
DISCORD_ONSUCCESS_WEBHOOK_URL=
DISCORD_ONFAIL_WEBHOOK_URL=
DISCORD_BALANCE_WEBHOOK_URL=

# Funding wallet — auto-tops-up subwallets when balance drops below MIN_BASE_BALANCE_ETH
FUNDING_EXECUTOR=

# Minimum ETH balance before auto-funding kicks in (default 0.005)
MIN_BASE_BALANCE_ETH=0.005

# Set to true to simulate only — no transactions sent (safe for testing against mainnet)
DRY_RUN=true
LOG_LEVEL=debug

# Delay before assigning merchants after OrderPlaced (seconds)
ASSIGN_DELAY_IN_SECONDS=30

# ── Keeper ─────────────────────────────────────────────────────────────
# Goldsky subgraph endpoint used by the keeper to enumerate
# unstake-requested + inactive merchants. Defaults to the prod endpoint when unset.
SUBGRAPH_URL=
# How often (hours, 1–24) the keeper run fires: approveUnstakeBatch +
# blacklistInactiveMerchants. Default 3. Both are idempotent and skip the tx
# entirely when nothing is due, so a tighter interval mostly costs subgraph
# reads. (Replaces the old DAILY_KEEPER_CRON_HOUR, which is no longer read.)
DAILY_KEEPER_INTERVAL_HOURS=3

# ── Insurance settlement (optional) ────────────────────────────────────
# Insurance Diamond address. UNSET = the whole settlement keeper is off:
# no ClaimApproved listener, no reconciliation scan, no settle jobs.
# Only set this AFTER the permissionless-settleClaim facet cut is live —
# before the cut every settle reverts NotAuthorized.
# Settles are signed by KEEPER_EXECUTOR on the same queue as the keeper run.
INSURANCE_DIAMOND_ADDRESS=
# Fallback reconciliation interval in minutes, default 180 (3h). The primary
# path is the ClaimApproved listener's delayed job at the exact maturity time;
# this only bounds how long a claim waits when its WS event was missed.
SETTLE_SCANNER_INTERVAL_MIN=180

# REQUIRED — executor wallet private keys.
# Keys are only ever read from the environment; the executor never generates a
# wallet and never persists a key to Redis or disk. A missing key fails the
# boot. To rotate a wallet: update the env var and redeploy.
TOGGLE_EXECUTOR=
ASSIGN_EXECUTOR=
ORDER_SWEEPER_EXECUTOR=
# Cashback wallet (signs integrator.issueCredit). Its address MUST be
# whitelisted on the integrator via setCreditIssuer(addr, true) before any
# credit issuance lands.
CASHBACK_EXECUTOR=
# Daily keeper wallet (signs approveUnstakeBatch + blacklistInactiveMerchants).
# Both calls are permissionless so any funded wallet works — it just needs gas.
KEEPER_EXECUTOR=

# ── B2B cashback programme ─────────────────────────────────────────────
# Both fields opt-in: programme is OFF when either is unset (or bps=0).
# When OFF the OrderCompleted listener still attaches but silently no-ops,
# and the cashback worker is not started. Toggling on later requires a
# restart so the env is re-read.
CASHBACK_INTEGRATOR_ADDRESS=
# Default bps of completed non-B2B BUY/SELL amount → credit. 200 = 2%. Range [0, 10000].
CASHBACK_BPS=
# Per-currency overrides for the default rate above, as a comma-separated
# list of CODE:bps pairs keyed by the order's currency symbol. A currency
# listed here uses its rate instead of CASHBACK_BPS; everything else falls
# back to the default. Argentina (ARS) and Mexico (MEX) default to 1%
# (100 bps) even when this is unset; set them explicitly here to change it.
# Example: ARS:100,MEX:100,VEN:50
CASHBACK_BPS_BY_CURRENCY=
