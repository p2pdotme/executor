# Redis is set by docker-compose — do not change this
REDIS_URL=redis://redis:6379

# Alchemy RPC key for Base network
ALCHEMY_API_KEY=

# Diamond contract address on Base
DIAMOND_ADDRESS=

# Discord channel webhooks — one per alert type
DISCORD_ONSUCCESS_WEBHOOK_URL=
DISCORD_ONFAIL_WEBHOOK_URL=
DISCORD_BALANCE_WEBHOOK_URL=

# Funding wallet — auto-tops-up subwallets when balance drops below MIN_BASE_BALANCE_ETH
FUNDING_EXECUTOR=

# Minimum ETH balance before auto-funding kicks in (default 0.005)
MIN_BASE_BALANCE_ETH=0.005

# Delay before assigning merchants after OrderPlaced (seconds)
ASSIGN_DELAY_IN_SECONDS=90

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Set to true to simulate only — no transactions sent
DRY_RUN=false

# ---------------------------------------------------------------------------
# REQUIRED — executor wallet private keys
# Keys are only ever read from the environment; the executor never generates a
# wallet and never persists a key to Redis or disk. A missing key fails the
# boot. To rotate a wallet: update the env var below and restart the container.
# ---------------------------------------------------------------------------
TOGGLE_EXECUTOR=
ASSIGN_EXECUTOR=
ORDER_SWEEPER_EXECUTOR=
# Must be whitelisted on the cashback integrator via setCreditIssuer(addr, true).
CASHBACK_EXECUTOR=
# Daily keeper (approveUnstakeBatch + blacklistInactiveMerchants).
KEEPER_EXECUTOR=
